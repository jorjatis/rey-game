{{#if isButton}}
    <button {{#if id}}id="{{id}}"{{/if}} class="v-gk-btn {{#if isIcon}}v-gk-btn--icn{{/if}} {{#if sizeS}}v-gk-btn--s{{/if}} {{#if sizeXS}}v-gk-btn--xs{{/if}} {{#if typeLink}}v-gk-btn--lnk{{/if}} {{#if btnSecondary}}v-gk-btn--sec{{/if}} {{#if isDisabled}}is-disabled{{/if}} {{#if classes}}{{classes}}{{/if}}" {{#if popover}}popovertarget="{{popoverTarget}}" popovertargetaction="toggle"{{/if}} {{#if dataAttr}}data-{{dataAttr}}="{{dataAttrContent}}"{{/if}}>
{{else if isLink}}
    <a href="#" {{#if id}}id="{{id}}"{{/if}} class="v-gk-btn {{#if sizeS}}v-gk-btn--s{{/if}} {{#if sizeXS}}v-gk-btn--xs{{/if}} {{#if typeLink}}v-gk-btn--lnk{{/if}} {{#if btnSecondary}}v-gk-btn--sec{{/if}} {{#if isDisabled}}is-disabled{{/if}} {{#if classes}}{{classes}}{{/if}}" {{#if dataAttr}}data-{{dataAttr}}="{{dataAttrContent}}"{{/if}}></a>
{{/if}}

    {{#if prevIcon}}
        {{> icon }}
    {{/if}}

    {{#if text}}
        <span>{{text}}</span>
    {{else if noText}}
    {{else}}
        <span>Texto del botón</span>
    {{/if}}

    {{#if icon}}
        {{> icon }}
    {{/if}}

{{#if isButton}}
    </button>
{{else if isLink}}
    </a>
{{/if}}