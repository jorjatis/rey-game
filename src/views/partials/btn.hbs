{{#if isButton}}
    <button class="v-gk-btn {{#if isIcon}}v-gk-btn--icn{{/if}} {{#if sizeS}}v-gk-btn--s{{/if}} {{#if typeLink}}v-gk-btn--lnk{{/if}} {{#if btnSecondary}}v-gk-btn--sec{{/if}} {{#if isDisabled}}is-disabled{{/if}} {{#if classes}}{{classes}}{{/if}}" {{{others}}}>
{{else if isLink}}
    <a href="#" class="v-gk-btn {{#if sizeS}}v-gk-btn--s{{/if}} {{#if typeLink}}v-gk-btn--lnk{{/if}} {{#if btnSecondary}}v-gk-btn--sec{{/if}} {{#if isDisabled}}is-disabled{{/if}} {{#if classes}}{{classes}}{{/if}}" {{{others}}}></a>
{{/if}}

    {{#if text}}
        <span>{{text}}</span>
    {{else if noText}}
    {{else}}
        <span>Texto del botón</span>
    {{/if}}

    {{#if icon}}
        <span class="v-gk-icn">
            {{#if iconShare}}
                {{> icons/icon-share }}
            {{/if}}

            {{#if iconReload}}
                {{> icons/icon-reload }}
            {{/if}}

            {{#if iconLevel }}
                {{> icons/icon-level  }}
            {{/if}}

            {{#if iconOptions}}
                {{> icons/icon-cog }}
            {{/if}}

            {{#if iconClose}}
                {{> icons/icon-close }}
            {{/if}}
        </span>
    {{/if}}

{{#if isButton}}
    </button>
{{else if isLink}}
    </a>
{{/if}}