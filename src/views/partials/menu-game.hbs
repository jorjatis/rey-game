<section class="v-gk-menu-game">
    <div class="v-gk-menu-game__h">
        {{> btn
            isButton=true
            isIcon=true
            noText=true
            icon=true
            iconOptions=true
        }}

        {{> btn
            isButton=true
            typeLink=true
            text="Cómo jugar"
            popover=true
            popoverTarget="howToPlay"
        }}
    </div>

    <div class="v-gk-menu-game__cnt">
        <div class="v-gk-menu-game__media">
            <img src="assets/images/menu-game.png" alt="">
        </div>

        <h1>¿Cuánto sabes de la historia reciente de España?</h1>

        <p>Pulsa sobre los eventos históricos que irán apareciendo y arrástralos, antes o después de otro evento, hasta colocarlos en el orden cronológico correcto</p>

        <div class="v-gk-lvl-sel">
            <p>Selecciona un nivel de dificultad</p>
            <div class="v-gk-lvl-sel__btns">
                {{> btn
                    isButton=true
                    classes="v-gk-btn--lvl"
                    btnSecondary=true
                    sizeS=true
                    text="Nivel 1"
                    icon=true 
                    iconLevel=true
                    level1=true
                    dataAttr="level"
                    dataAttrContent="1"
                }}

                {{> btn
                    isButton=true
                    classes="v-gk-btn--lvl"
                    btnSecondary=true
                    sizeS=true
                    text="Nivel 2"
                    icon=true 
                    iconLevel=true
                    level2=true
                    dataAttr="level"
                    dataAttrContent="2"
                }}

                {{> btn
                    isButton=true
                    classes="v-gk-btn--lvl"
                    btnSecondary=true
                    sizeS=true
                    text="Nivel 3"
                    icon=true 
                    iconLevel=true
                    level3=true
                    dataAttr="level"
                    dataAttrContent="3"
                }}
            </div>
        </div>
    </div>

    <div class="v-gk-menu-game__ftr">
        <div class="v-gk-btn-grp">
            {{> btn
                isButton=true
                isDisabled=true
                text="Empezar"
                id="startGameBtn"
            }}
        </div>
    </div>

</section>