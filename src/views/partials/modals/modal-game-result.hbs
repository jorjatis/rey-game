{{#> popover }}

    <div class="v-gk-modal__cnt">
        <h2>¡Una puntuación de matrícula!</h2>

        <p>Tienes más memoria que Jordi Hurtado</p>

        <div class="v-gk-points">
            <img src="assets/images/results-stars.png" alt="">
            <span class="v-gk-points__result">
                <span class="v-gk-points__txt">Resultado</span>
                <span class="v-gk-points__num">8</span>
                <span class="v-gk-points__txt-2">puntos</span>
            </span>
            <img src="assets/images/results-stars.png" alt="">
        </div>

    </div>

    <div class="v-gk-modal__ftr">
        <div class="v-gk-btn-grp">
            {{> btn
                isButton=true
                sizeS=true
                text="Compartir resultado"
                icon=true
                iconShare=true
            }}

            {{> btn
                isButton=true
                sizeS=true
                text="Volver a jugar"
                icon=true
                iconReload=true
                others="popovertarget=\"gameResult\" popovertargetaction=\"hide\""
            }}
        </div>
    </div>

    <div class="v-gk-share">
        <div class="v-gk-share__h">
            <span>Compartir</span>

            {{> btn
                isButton=true
                classes="v-gk-btn--x"
                noText=true
                icon=true
                iconClose=true
            }}
        </div>

        <ul class="v-gk-share__l">
            <li>
                <div class="v-gk-icn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"><path fill="#000" d="M9.847 5.59a4.58 4.58 0 0 1 .011 6.47l-.011.01-2.026 2.03A4.585 4.585 0 0 1 1.34 7.615L2.459 6.5a.482.482 0 0 1 .823.32c.02.541.118 1.076.292 1.59a.485.485 0 0 1-.114.5l-.395.39a2.171 2.171 0 1 0 3.05 3.09l2.026-2.027a2.17 2.17 0 0 0-.312-3.328.483.483 0 0 1-.209-.38 1.2 1.2 0 0 1 .353-.9l.635-.635a.484.484 0 0 1 .621-.052 4.6 4.6 0 0 1 .619.518l-.001.003ZM14.1 1.34a4.588 4.588 0 0 0-6.481 0l-2.03 2.026-.011.011a4.583 4.583 0 0 0 .63 6.988.484.484 0 0 0 .621-.052l.635-.635a1.2 1.2 0 0 0 .353-.9.483.483 0 0 0-.209-.38 2.17 2.17 0 0 1-.312-3.328l2.025-2.024a2.171 2.171 0 1 1 3.05 3.09l-.395.394a.486.486 0 0 0-.114.5c.174.513.273 1.048.292 1.59a.482.482 0 0 0 .823.32L14.1 7.82a4.587 4.587 0 0 0 0-6.48Z"/></svg>
                </div>
            </li>
        </ul>
    </div>

{{/ popover}}
