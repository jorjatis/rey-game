<div class="v-gk-share">
    <div class="v-gk-share__h">
        <span>Compartir</span>

        {{> btn
            isButton=true
            classes="v-gk-btn--x"
            noText=true
            icon=true
            iconClose=true
        }}
    </div>

    <ul class="v-gk-share__l">
        <li>
            <a href="#">
                <span class="v-gk-icn">
                    {{> ./icons/icon-share-2 }}
                </span>
                <span>Copiar enlace</span>
            </a>
        </li>

        <li>
            <a href="#">
                <span class="v-gk-icn">
                    {{> ./icons/icon-facebook }}
                </span>
                <span>Facebook</span>
            </a>
        </li>

        <li>
            <a href="#">
                <span class="v-gk-icn">
                    {{> ./icons/icon-twitter }}
                </span>
                <span>Twitter</span>
            </a>
        </li>

        <li>
            <a href="#">
                <span class="v-gk-icn">
                    {{> ./icons/icon-whatsapp }}
                </span>
                <span>Whatsapp</span>
            </a>
        </li>

        <li>
            <a href="#">
                <span class="v-gk-icn">
                    {{> ./icons/icon-email }}
                </span>
                <span>Email</span>
            </a>
        </li>
    </ul>
</div>